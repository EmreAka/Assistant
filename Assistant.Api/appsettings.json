{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Assistant.Api.Features.Chat.Services.ChatTurnService": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Bot": {
    "BotToken": "YOUR_BOT_TOKEN",
    "WebhookUrl": "YOUR_WEBHOOK_URL",
    "SecretToken": "YOUR_SECRET_TOKEN",
    "AllowedChatIds": [12345]
  },
  "AIProviders": {
    "OpenRouter": {
      "ApiKey": "",
      "ApiUrl": "https://openrouter.ai/api/v1",
      "Model": "deepseek/deepseek-v4.1-flash",
      "WebSearch": {
        "Enabled": true,
        "Engine": "auto",
        "MaxResults": 5,
        "MaxUses": 3,
        "SearchContextSize": ""
      },
      "Reasoning": {
        "Chat": "ExtraHigh",
        "MemoryConsolidation": "ExtraHigh",
        "MemoryExtraction": "ExtraHigh",
        "Emotion": "Low"
      }
    },
    "GoogleAIStudio": {
      "ApiKey": "",
      "Model": "gemini-3.1-flash-lite"
    },
    "XAI": {
      "ApiKey": "",
      "ApiUrl": "https://api.x.ai/v1",
      "Model": "grok-4.3",
      "TtsVoiceId": "Carina",
      "TtsLanguage": "en"
    },
    "DefaultTimeZoneId": "Europe/Istanbul"
  },
  "MemoryConsolidation": {
    "TurnsThreshold": 20,
    "StaleJobAfterMinutes": 15
  },
  "Embeddings": {
    "Model": "google/gemini-embedding-2",
    "Dimensions": 768,
    "TurnsThreshold": 20,
    "MaxTurnsPerRun": 50,
    "MaxCosineDistance": 0.5
  },
  "MemoryItems": {
    "Model": "deepseek/deepseek-v4.1-flash",
    "TurnsThreshold": 10,
    "MaxTurnsPerRun": 30,
    "MaxCandidatesPerRun": 20,
    "ReconcileTopK": 5,
    "ReconcileMaxCosineDistance": 0.35,
    "MaxCoreItems": 40,
    "RetrievalTopK": 8,
    "RetrievalMaxCosineDistance": 0.5,
    "MaxItemLength": 300
  },
  "Emotion": {
    "Enabled": true,
    "Model": "deepseek/deepseek-v4.1-flash",
    "BaselineValence": 0.3,
    "BaselineArousal": 0.5,
    "BaselineMood": "relaxed",
    "HalfLifeHours": 6,
    "MaxDeltaPerTurn": 0.3,
    "Events": {
      "neutral": { "Valence": 0, "Arousal": 0 },
      "affection": { "Valence": 0.15, "Arousal": 0.05 },
      "playful": { "Valence": 0.10, "Arousal": 0.15 },
      "good_news": { "Valence": 0.15, "Arousal": 0.15 },
      "bad_news": { "Valence": -0.15, "Arousal": 0.10 },
      "cold": { "Valence": -0.05, "Arousal": -0.10 },
      "rude": { "Valence": -0.20, "Arousal": 0.15 }
    },
    "IntensityMultipliers": {
      "low": 0.5,
      "medium": 1.0,
      "high": 1.5
    },
    "CheckIns": {
      "Enabled": false,
      "QuietHoursStart": "23:00",
      "QuietHoursEnd": "09:00",
      "MinMinutesSinceLastMessage": 30,
      "MaxDaysAhead": 7
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5432;Database=assistant;Username=postgres;Password=postgres",
    "HangfireDb": "Host=localhost;Port=5432;Database=hangfire;Username=postgres;Password=postgres"
  }
}
